# ── Supabase (프로젝트: ap-northeast-2 서울 리전) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role 키. 서버 전용 — NEXT_PUBLIC_ 접두 절대 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 검증 API용 토큰 (전부 서버 전용) ──────────────────────────────
# 내 GitHub PAT (read:org 스코프) — 의뢰인 조직에 내가 초대됐는지 확인
GITHUB_TOKEN=ghp_xxx
# 내 Vercel 액세스 토큰 — 의뢰인 팀에 내가 포함됐는지 확인
# (Vercel 배포 환경변수는 VERCEL_ 접두 이름을 예약어로 막으므로 이 이름을 쓴다)
VERCEL_API_TOKEN=xxx
# 내 Supabase 개인 액세스 토큰 — 의뢰인 조직에 내가 포함됐는지 확인
SUPABASE_ACCESS_TOKEN=sbp_xxx

# ── 사이트 ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
