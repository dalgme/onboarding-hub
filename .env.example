# ── Supabase (프로젝트: ap-northeast-2 서울 리전) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role 키. 서버 전용 — NEXT_PUBLIC_ 접두 절대 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 검증 API용 토큰 (전부 서버 전용) ──────────────────────────────
# 내 GitHub PAT (read:org 스코프) — 의뢰인 조직에 내가 초대됐는지 확인
GITHUB_TOKEN=ghp_xxx
# 내 Vercel 액세스 토큰 — 의뢰인 팀에 내가 포함됐는지 확인
# (Vercel 배포 환경변수는 VERCEL_ 로 시작하는 모든 이름을 예약어로 막는다)
MY_VERCEL_TOKEN=xxx
# 내 Supabase 개인 액세스 토큰 — 의뢰인 조직에 내가 포함됐는지 확인
SUPABASE_ACCESS_TOKEN=sbp_xxx

# ── 온보딩 도우미 챗봇 (선택) ─────────────────────────────────────
# 내 Anthropic API 키. 계정 연결 단계에서 의뢰인 질문에 답하는 도우미가 쓴다.
# 이 도구는 내 소유이므로 내 키를 쓴다 (의뢰인 서비스의 키와는 별개).
# 비워 두면 도우미 버튼은 「준비되지 않았습니다」 안내만 하고, 온보딩은 정상 동작한다.
ANTHROPIC_API_KEY=sk-ant-xxx

# ── 사이트 ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
