# ── Supabase (프로젝트: ap-northeast-2 서울 리전) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role 키. 서버 전용 — NEXT_PUBLIC_ 접두 절대 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 검증 API용 토큰 (전부 서버 전용) ──────────────────────────────
# 내 GitHub PAT — 반드시 classic(ghp_) + read:org. fine-grained(github_pat_)는
# 의뢰인 조직 멤버십을 조회하지 못해 동작하지 않는다
GITHUB_TOKEN=ghp_xxx
# 내 Vercel 액세스 토큰 — 의뢰인 팀에 내가 포함됐는지 확인
# (Vercel 배포 환경변수는 VERCEL_ 로 시작하는 모든 이름을 예약어로 막는다)
MY_VERCEL_TOKEN=xxx
# 내 Supabase 개인 액세스 토큰 — 의뢰인 조직에 내가 포함됐는지 확인
SUPABASE_ACCESS_TOKEN=sbp_xxx

# ── 온보딩 도우미 챗봇 (선택) ─────────────────────────────────────
# 내 Anthropic API 키. 계정 연결 단계에서 의뢰인 질문에 답하는 도우미가 쓴다.
# 이 도구는 내 소유이므로 내 키를 쓴다 (의뢰인 서비스의 키와는 별개).
# 비워 두면 도우미 버튼은 「준비되지 않았습니다」 안내만 하고, 온보딩은 정상 동작한다.
ANTHROPIC_API_KEY=sk-ant-xxx

# ── 관리자 휴대폰 알림 (웹 푸시, 선택) ───────────────────────────
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` 로 한 번 만든다.
# 비워 두면 알림만 꺼지고 나머지는 정상 동작한다.
# 공개 키는 브라우저 구독에도 쓰이므로 NEXT_PUBLIC_ 하나만 둔다 — 두 값은 반드시
# 같은 generateVAPIDKeys() 결과의 짝이어야 한다. (NEXT_PUBLIC_ 값은 빌드에 박히므로 바꾸면 재배포)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── 사이트 ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
