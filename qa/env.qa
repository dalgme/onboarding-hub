# 검수용 환경변수 — 전부 가짜 값이다. 모의 서버(qa/mock/server.mjs)와 짝이 맞아야 한다.
# run.sh 가 이 파일을 export 한 채로 앱을 빌드·실행한다 (NEXT_PUBLIC_* 는 빌드에 박힌다).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=qa-anon-key
SUPABASE_SERVICE_ROLE_KEY=qa-service-role-key
GITHUB_TOKEN=ghp_qa_token_not_real
MY_VERCEL_TOKEN=qa-vercel-token
SUPABASE_ACCESS_TOKEN=sbp_qa_token_not_real
SITE_URL=http://127.0.0.1:3100
MAGIC_LINK_TTL_HOURS=24
CRON_SECRET=qa-cron-secret
HEARTBEAT_URL=https://heartbeat.qa.local/ping
QA_MOCK_URL=http://127.0.0.1:54321
QA_APP_URL=http://127.0.0.1:3100
QA_ADMIN_EMAIL=admin@qa.local
QA_ADMIN_PASSWORD=admin-pass-1234
PORT=3100
